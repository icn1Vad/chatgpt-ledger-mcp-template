{
  "name": "chatgpt-ledger-mcp-template",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "node dist/index.js",
    "start:ts": "tsx server/src/index.ts",
    "build": "tsc",
    "inspect": "npx @modelcontextprotocol/inspector http://localhost:3210/mcp",
    "sync:local": "python scripts/sync.py --source exports/raw-transactions.json",
    "analyze": "python scripts/analyze.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
